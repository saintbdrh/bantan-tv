# The settings the site reads. Production values live in Cloudflare:
#   Workers -> bantan-tv -> Settings -> Variables and Secrets (runtime), and the
#   non-secret ones also under Settings -> Build -> Variables and secrets, because
#   pages are pre-rendered during the build.
# Local development: copy to .env.local and fill in only what you need. Do NOT put
# secrets in .env files: OpenNext bakes .env files into the Worker when you build.
# For `npm run preview`, put AUTH_SECRET in .dev.vars instead (see .dev.vars.example).

# Secret, required in production (min. 32 characters): signs login cookies.
# Generate with: openssl rand -hex 32. `next dev` works without it.
# AUTH_SECRET=

# Optional secret: Apps Script / webhook URL that receives each ad booking as JSON
# BOOKING_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# Optional secret: YouTube Data API key for the schedule's trailer lookup
# YOUTUBE_API_KEY=

# Optional: custom domain connected to the R2 bucket bantan-data (trailers, posters);
# replaces *.r2.dev links. Also add its host to next.config.mjs and lib/images.ts.
# R2_PUBLIC_URL=https://media.bantan.tv

# Optional: where the trailer-list Worker lives (default: the current workers.dev URL)
# VIDEO_API_URL=https://bantan-tv-video-api.duuganbadrakh69.workers.dev

# Optional: "Publish to web" CSV link of the «Movie list монгол» tab (BantanTV_2.0 EPG).
# Without it the site uses the copy in lib/movie-library-data.ts.
# MOVIE_LIBRARY_CSV_URL=https://docs.google.com/spreadsheets/d/e/<id>/pub?gid=<gid>&single=true&output=csv

# Optional: CSV link of the movie info sheet (default: the "Bantan TV — Вэбсайтын
# кино мэдээлэл" sheet, which must be shared as "Anyone with the link can view")
# MOVIE_INFO_CSV_URL=https://docs.google.com/spreadsheets/d/<id>/export?format=csv

# Optional: extra trailer host, files at <MEDIA_BASE_URL>/trailers/<movie-id>.mp4
# MEDIA_BASE_URL=https://media.example.com

# Build-time only: seconds to skip at the start of Drive trailers (default 4)
# NEXT_PUBLIC_DRIVE_TRAILER_SKIP_SECONDS=4
